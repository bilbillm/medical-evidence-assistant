{
  "name": "medical-evidence-chat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node -e \"console.log('Run npm run dev:api and npm run dev:web in two terminals, or use npm run start:demo for Docker.')\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "test": "vitest run",
    "start:demo": "powershell -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "stop:demo": "powershell -ExecutionPolicy Bypass -File scripts/stop-demo.ps1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
